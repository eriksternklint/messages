# =============================================================================
# .env.example — TEMPLATE FILE (safe to commit)
#
# DO NOT put real secrets in this file.
# Copy this file to `.env.local` and fill in real values there.
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic (Claude AI)
# Required for live RSS ingestion + AI story generation.
# Get one at: https://console.anthropic.com/settings/keys
# Without this, the app runs on seed data only.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Notion
# Create an integration: https://www.notion.so/profile/integrations
# Paste the "Internal Integration Secret" as NOTION_API_KEY
# -----------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# -----------------------------------------------------------------------------
# Supabase (Postgres + Auth + Realtime)
# Create a project: https://supabase.com/dashboard
# Settings → API → copy these values
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WhatsApp (MOCKED for MVP via DMA third-party chat interop)
# No real keys needed — the app simulates a DMA provider locally.
# -----------------------------------------------------------------------------
WHATSAPP_MOCK_ENABLED=true
